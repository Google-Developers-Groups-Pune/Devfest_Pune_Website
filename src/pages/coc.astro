---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { cocData } from '../data';
---

<BaseLayout title="Code of Conduct">
  <div class="container narrow">
    <PageHeader title="Code of Conduct" />
    {cocData.map((section) => (
      <section>
        <h2>{section.name}</h2>
        <p>{section.des}</p>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .narrow {
    max-width: 820px;
  }
  section {
    margin-bottom: 32px;
  }
  h2 {
    font-size: 1.3rem;
  }
  p {
    white-space: pre-line;
  }
</style>
