---
import BaseLayout from '../layouts/BaseLayout.astro';
import { mainData } from '../data';
import {
  sessions,
  tracks,
  rowStarts,
  placement,
  eventDate,
  stats,
  TOPICS,
  type AgendaSession,
} from '../lib/agenda';

const date = new Date(`${eventDate} 00:00:00`);
const longDate = date.toLocaleDateString('en-GB', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const isoDate = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
const doorsOpen = sessions[0]?.startLabel;

// Grid cells in reading order (row by row), so the mobile stacked view reads correctly.
const cells = sessions
  .map((session) => ({ session, ...placement(session) }))
  .sort((a, b) => a.row - b.row || a.column - b.column);

// Empty slots get a placeholder so the dashed column dividers stay continuous.
const taken = new Set<string>();
for (const c of cells) {
  for (let r = c.row; r < c.row + c.rowSpan; r++) {
    for (let col = c.column; col < c.column + c.columnSpan; col++) taken.add(`${r}:${col}`);
  }
}
const empties = rowStarts.flatMap((_, i) =>
  tracks
    .map((_, j) => ({ row: i + 2, column: j + 2 }))
    .filter(({ row, column }) => !taken.has(`${row}:${column}`)),
);

const trackColor = (name: string) => tracks.find((t) => t.name === name)?.color ?? 'yellow';
const speakerNames = (s: AgendaSession) => s.speakers.map((p) => p.name).join(', ');
const sessionsFor = (track: string) => sessions.filter((s) => s.common || s.track === track);
const searchText = (s: AgendaSession) => `${s.title} ${speakerNames(s)} ${s.track}`.toLowerCase();
// Breaks and everyone-together moments are on everyone's plan already.
const saveable = (s: AgendaSession) => !s.common;

const statItems = [
  { value: stats.sessions, label: 'sessions', color: 'blue' },
  { value: stats.speakers, label: 'speakers', color: 'red' },
  { value: stats.tracks, label: 'parallel tracks', color: 'yellow' },
  { value: stats.hours, label: 'hours', color: 'green' },
];
---

<BaseLayout
  title="Agenda"
  description={`The full ${mainData.eventInfo.name} agenda: talks, panels and workshops across ${tracks.length} tracks.`}
>
  <section class="agenda container" data-date={isoDate}>
    <header class="top">
      <h1 class="title">
        <span class="brace" aria-hidden="true">
          &#123;
        </span>
        <span class="word">Agenda</span>
        <span class="brace" aria-hidden="true">
          &#125;
        </span>
      </h1>
      <p class="text-lg intro">
        {longDate}. Doors open at {doorsOpen}. Yellow rows bring everyone together in the main hall.
        Star the talks you want and they'll gather in <strong>My plan</strong>.
      </p>
      <ul class="stats">
        {statItems.map((item) => (
          <li style={`--c: var(--${item.color}); --bg: var(--${item.color}-pastel)`}>
            <strong data-count={item.value}>{item.value}</strong>
            <span>{item.label}</span>
          </li>
        ))}
      </ul>
    </header>

    <!-- Sticky bar: views, search and topic filters -->
    <div class="toolbar">
      <div class="tabs" role="tablist" aria-label="Agenda views">
        <span class="indicator" aria-hidden="true"></span>
        <button role="tab" id="tab-overview" aria-controls="view-overview" aria-selected="true">
          Overview
        </button>
        {tracks.map((track, i) => (
          <button
            role="tab"
            id={`tab-${i}`}
            aria-controls={`view-${i}`}
            aria-selected="false"
            tabindex="-1"
            style={`--dot: var(--${track.color})`}
          >
            <i aria-hidden="true" />
            {track.name}
          </button>
        ))}
        <button
          role="tab"
          id="tab-plan"
          aria-controls="view-plan"
          aria-selected="false"
          tabindex="-1"
        >
          <svg class="star" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"></path>
          </svg>
          My plan{' '}
          <span class="plan-count" data-plan-count>
            0
          </span>
        </button>
      </div>

      <div class="filters">
        <label class="search">
          <span class="sr-only">Search talks or speakers</span>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="M20 20l-3.5-3.5"></path>
          </svg>
          <input type="search" placeholder="Search talks or speakers" autocomplete="off" />
        </label>
        <div class="topics" role="group" aria-label="Filter by topic">
          {TOPICS.map((topic) => (
            <button class="topic" data-topic={topic.id} aria-pressed="false">
              {topic.label}
            </button>
          ))}
        </div>
        <p class="result" aria-live="polite"></p>
      </div>
    </div>

    <!-- Overview: time grid with one column per track -->
    <div class="view" id="view-overview" role="tabpanel" aria-labelledby="tab-overview">
      <div class="grid" style={`--tracks: ${tracks.length}`}>
        <div class="head time-head">Time</div>
        {tracks.map((track, i) => (
          <div class="head" style={`grid-column: ${i + 2}; --accent: var(--${track.color})`}>
            {track.name}
          </div>
        ))}
        {rowStarts.map((start, i) => {
          const common = sessions.find((s) => s.common && s.start === start);
          const labelText = sessions.find((s) => s.start === start)!.startLabel;
          return (
            <div
              class="time"
              style={`grid-row: ${i + 2}; --order: ${(i + 2) * 100}`}
              data-common={common ? '' : undefined}
            >
              {common ? `${common.startLabel} to ${common.endLabel}` : labelText}
            </div>
          );
        })}
        {empties.map(({ row, column }) => (
          <div
            class="empty"
            style={`grid-row: ${row}; grid-column: ${column}`}
            aria-hidden="true"
          />
        ))}
        {cells.map(({ session, row, rowSpan, column, columnSpan }) => (
          <article
            class:list={['cell', session.common && 'common', session.isBreak && 'break']}
            style={`grid-row: ${row} / span ${rowSpan}; grid-column: ${column} / span ${columnSpan}; --accent: var(--${trackColor(session.track)}); --order: ${row * 100 + column}`}
            data-id={session.id}
            data-start={session.start}
            data-end={session.end}
            data-topics={session.topics.join(' ')}
            data-search={searchText(session)}
          >
            <span class="meta">
              <span class="chip-track">{session.common ? 'Everyone' : session.track}</span>
              {!session.common && (
                <span class:list={['kind', `kind--${session.kind.toLowerCase()}`]}>
                  {session.kind}
                </span>
              )}
            </span>
            <button class="open" data-open={session.id}>
              {session.title}
            </button>
            {session.speakers.length > 0 && (
              <span class="cell-speakers">{speakerNames(session)}</span>
            )}
            <span class="cell-time">
              {session.startLabel} to {session.endLabel}
            </span>
            {saveable(session) && (
              <button
                class="save"
                data-save={session.id}
                aria-pressed="false"
                aria-label={`Save “${session.title}” to my plan`}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z" />
                </svg>
              </button>
            )}
          </article>
        ))}
      </div>
    </div>

    <!-- One view per track: its sessions plus the shared ones, in time order -->
    {tracks.map((track, i) => (
      <div
        class="view"
        id={`view-${i}`}
        role="tabpanel"
        aria-labelledby={`tab-${i}`}
        hidden
        style={`--accent: var(--${track.color}); --accent-pastel: var(--${track.color}-pastel)`}
      >
        <ol class="timeline">
          {sessionsFor(track.name).map((session) => (
            <li
              class:list={[session.common && 'common', session.isBreak && 'break']}
              data-id={session.id}
              data-start={session.start}
              data-end={session.end}
              data-topics={session.topics.join(' ')}
              data-search={searchText(session)}
            >
              <time>
                {session.startLabel}
                <small>to {session.endLabel}</small>
              </time>
              <div class="entry">
                <button class="open" data-open={session.id}>
                  {session.title}
                </button>
                {session.speakers.length > 0 && (
                  <span class="cell-speakers">{speakerNames(session)}</span>
                )}
                {saveable(session) && (
                  <button
                    class="save"
                    data-save={session.id}
                    aria-pressed="false"
                    aria-label={`Save “${session.title}” to my plan`}
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z" />
                    </svg>
                  </button>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    ))}

    <!-- My plan: shared sessions plus the starred ones; filled in by the script -->
    <div
      class="view plan"
      id="view-plan"
      role="tabpanel"
      aria-labelledby="tab-plan"
      hidden
      style="--accent: var(--yellow); --accent-pastel: var(--yellow-pastel)"
    >
      <div class="plan-empty">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"></path>
        </svg>
        <h2>Your plan is empty</h2>
        <p>
          Star talks in the overview or any track, and they'll line up here with the breaks around
          them.
        </p>
      </div>
      <div class="plan-head">
        <p>Saved on this device only.</p>
        <button class="button button--secondary" data-export>
          Add my plan to calendar
        </button>
      </div>
      <ol class="timeline">
        {sessions.map((session) => (
          <li
            class:list={[session.common && 'common', session.isBreak && 'break']}
            data-id={session.id}
            data-plan-item
            data-common={session.common ? '' : undefined}
            data-start={session.start}
            data-end={session.end}
            data-title={session.title}
            data-track={session.track}
            hidden={!session.common}
          >
            <time>
              {session.startLabel}
              <small>to {session.endLabel}</small>
            </time>
            <div class="entry">
              <button class="open" data-open={session.id}>
                {session.title}
              </button>
              {!session.common && <span class="cell-speakers">{session.track}</span>}
              <span class="clash" hidden />
              {saveable(session) && (
                <button
                  class="save"
                  data-save={session.id}
                  aria-pressed="true"
                  aria-label={`Remove “${session.title}” from my plan`}
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z" />
                  </svg>
                </button>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>

    <!-- Session details, filled from the matching template when a session is opened -->
    <dialog class="details" aria-labelledby="details-title">
      <div class="details-body"></div>
      <div class="details-actions">
        <button class="button" data-dialog-save hidden>
          Save to my plan
        </button>
        <form method="dialog">
          <button class="button button--outline">Close</button>
        </form>
      </div>
    </dialog>
    {sessions.map((session) => (
      <template id={`session-${session.id}`} data-saveable={saveable(session) ? '' : undefined}>
        <p class="details-meta">
          {session.startLabel} to {session.endLabel} ·{' '}
          {session.common ? 'Main hall, everyone' : `${session.track} · ${session.kind}`}
        </p>
        <h2 id="details-title">{session.title}</h2>
        <p>{session.description}</p>
        {session.speakers.length > 0 && (
          <ul class="details-speakers">
            {session.speakers.map((speaker) => (
              <li>
                <strong>{speaker.name}</strong>
                {speaker.role && <span>{speaker.role}</span>}
              </li>
            ))}
          </ul>
        )}
      </template>
    ))}
  </section>
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrambleTextPlugin } from 'gsap/ScrambleTextPlugin';

  gsap.registerPlugin(ScrambleTextPlugin);
  const motion = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const root = document.querySelector<HTMLElement>('.agenda')!;
  const $$ = <T extends HTMLElement = HTMLElement>(s: string) => [...root.querySelectorAll<T>(s)];

  /* ---------- my plan (stored in this browser only) ---------- */
  const STORE = 'devfest-pune-plan';
  const load = (): Set<string> => {
    try {
      return new Set(JSON.parse(localStorage.getItem(STORE) ?? '[]'));
    } catch {
      return new Set();
    }
  };
  const saved = load();
  const persist = () => {
    try {
      localStorage.setItem(STORE, JSON.stringify([...saved]));
    } catch {
      /* storage unavailable: the plan still works for this visit */
    }
  };

  function renderPlan() {
    $$<HTMLButtonElement>('[data-save]').forEach((b) =>
      b.setAttribute('aria-pressed', String(saved.has(b.dataset.save!))),
    );
    root.querySelector('[data-plan-count]')!.textContent = String(saved.size);
    const plan = root.querySelector<HTMLElement>('#view-plan')!;
    plan.classList.toggle('is-empty', saved.size === 0);

    // Show shared sessions plus starred ones; flag starred talks that overlap.
    let previous: HTMLElement | null = null;
    $$('[data-plan-item]').forEach((item) => {
      const isSaved = saved.has(item.dataset.id!);
      item.hidden = !(item.dataset.common !== undefined || isSaved);
      const clash = item.querySelector<HTMLElement>('.clash')!;
      clash.hidden = true;
      if (!isSaved) return;
      if (previous && Number(item.dataset.start) < Number(previous.dataset.end)) {
        clash.hidden = false;
        clash.textContent = `Clashes with “${previous.dataset.title}”`;
      }
      previous = item;
    });
  }

  function toggleSave(id: string, source?: HTMLElement) {
    if (saved.has(id)) saved.delete(id);
    else saved.add(id);
    persist();
    renderPlan();
    if (motion && source && saved.has(id)) {
      gsap.fromTo(
        source,
        { scale: 0.6, rotate: -30 },
        { scale: 1, rotate: 0, duration: 0.6, ease: 'back.out(3)' },
      );
      gsap.fromTo(
        '#tab-plan .plan-count',
        { scale: 1.6 },
        { scale: 1, duration: 0.5, ease: 'back.out(3)' },
      );
    }
  }

  root.addEventListener('click', (e) => {
    const save = (e.target as HTMLElement).closest<HTMLElement>('[data-save]');
    if (save) toggleSave(save.dataset.save!, save);
  });

  // Download the plan as an .ics file (times are Pune time, UTC+05:30).
  root.querySelector('[data-export]')!.addEventListener('click', () => {
    const [y, m, d] = root.dataset.date!.split('-').map(Number);
    const stamp = (minutes: number) =>
      new Date(Date.UTC(y, m - 1, d, 0, minutes - 330))
        .toISOString()
        .replace(/[-:]/g, '')
        .replace(/\.\d{3}/, '');
    const events = $$('[data-plan-item]')
      .filter((item) => saved.has(item.dataset.id!))
      .map((item) =>
        [
          'BEGIN:VEVENT',
          `UID:${item.dataset.id}-${root.dataset.date}@devfest.gdgpune.in`,
          `DTSTAMP:${stamp(0)}`,
          `DTSTART:${stamp(Number(item.dataset.start))}`,
          `DTEND:${stamp(Number(item.dataset.end))}`,
          `SUMMARY:${item.dataset.title!.replace(/[,;\\]/g, (c) => `\\${c}`)}`,
          `LOCATION:${item.dataset.track} - DevFest Pune`,
          'END:VEVENT',
        ].join('\r\n'),
      );
    const ics = [
      'BEGIN:VCALENDAR',
      'VERSION:2.0',
      'PRODID:-//GDG Pune//DevFest Pune plan//EN',
      ...events,
      'END:VCALENDAR',
      '',
    ].join('\r\n');
    const link = document.createElement('a');
    link.href = URL.createObjectURL(new Blob([ics], { type: 'text/calendar' }));
    link.download = 'my-devfest-pune-plan.ics';
    link.click();
    URL.revokeObjectURL(link.href);
  });

  /* ---------- search and topic filters ---------- */
  const search = root.querySelector<HTMLInputElement>('.search input')!;
  const topics = $$<HTMLButtonElement>('.topic');
  const result = root.querySelector<HTMLElement>('.result')!;

  function applyFilters() {
    const query = search.value.trim().toLowerCase();
    const active = topics
      .filter((t) => t.getAttribute('aria-pressed') === 'true')
      .map((t) => t.dataset.topic!);
    const filtering = query !== '' || active.length > 0;
    const matched = new Set<string>();
    $$('[data-search]').forEach((el) => {
      const hit =
        (!query || el.dataset.search!.includes(query)) &&
        (!active.length || active.some((t) => el.dataset.topics!.split(' ').includes(t)));
      if (hit && !el.classList.contains('common')) matched.add(el.dataset.id!);
      el.classList.toggle('dim', filtering && !hit);
    });
    result.textContent = filtering
      ? matched.size
        ? `${matched.size} session${matched.size === 1 ? '' : 's'} match`
        : 'No sessions match. Try another word or topic.'
      : '';
  }
  search.addEventListener('input', applyFilters);
  topics.forEach((topic) =>
    topic.addEventListener('click', () => {
      topic.setAttribute('aria-pressed', String(topic.getAttribute('aria-pressed') !== 'true'));
      applyFilters();
    }),
  );

  /* ---------- tabs ---------- */
  const tabs = $$<HTMLButtonElement>('[role="tab"]');
  const indicator = root.querySelector<HTMLElement>('.indicator')!;
  const selected = () => tabs.find((t) => t.getAttribute('aria-selected') === 'true')!;

  const moveIndicator = (tab: HTMLElement, animate = true) =>
    gsap.to(indicator, {
      x: tab.offsetLeft,
      y: tab.offsetTop,
      width: tab.offsetWidth,
      height: tab.offsetHeight,
      duration: animate && motion ? 0.5 : 0,
      ease: 'expo.out',
    });

  const revealItems = (view: HTMLElement) => {
    if (!motion) return;
    gsap.from(
      view.querySelectorAll('.head, .time, .cell, .timeline li:not([hidden]), .plan-empty'),
      {
        y: 24,
        opacity: 0,
        duration: 0.6,
        ease: 'expo.out',
        stagger: { amount: 0.5 },
        clearProps: 'transform,opacity',
      },
    );
  };

  function select(tab: HTMLButtonElement) {
    const current = selected();
    if (current === tab) return;
    const from = document.getElementById(current.getAttribute('aria-controls')!)!;
    const to = document.getElementById(tab.getAttribute('aria-controls')!)!;
    current.setAttribute('aria-selected', 'false');
    current.tabIndex = -1;
    tab.setAttribute('aria-selected', 'true');
    tab.tabIndex = 0;
    moveIndicator(tab);
    gsap.to(from, {
      opacity: 0,
      y: -12,
      duration: motion ? 0.2 : 0,
      onComplete: () => {
        from.hidden = true;
        gsap.set(from, { clearProps: 'all' });
        to.hidden = false;
        revealItems(to);
      },
    });
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!step) return;
      const next = tabs[(i + step + tabs.length) % tabs.length];
      next.focus();
      select(next);
    });
  });
  moveIndicator(tabs[0], false);
  window.addEventListener('resize', () => moveIndicator(selected(), false));

  /* ---------- session details ---------- */
  const dialog = root.querySelector<HTMLDialogElement>('dialog.details')!;
  const body = dialog.querySelector<HTMLElement>('.details-body')!;
  const dialogSave = dialog.querySelector<HTMLButtonElement>('[data-dialog-save]')!;
  let openId = '';
  const syncDialogSave = () =>
    (dialogSave.textContent = saved.has(openId) ? 'Remove from my plan' : 'Save to my plan');

  root.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-open]');
    const template = trigger && document.getElementById(`session-${trigger.dataset.open}`);
    if (!(template instanceof HTMLTemplateElement)) return;
    openId = trigger!.dataset.open!;
    body.replaceChildren(template.content.cloneNode(true));
    dialogSave.hidden = template.dataset.saveable === undefined;
    syncDialogSave();
    dialog.showModal();
    if (motion) gsap.from(dialog, { y: 32, opacity: 0, duration: 0.4, ease: 'expo.out' });
  });
  dialogSave.addEventListener('click', () => {
    toggleSave(openId);
    syncDialogSave();
  });
  dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());

  /* ---------- live now (event day only, Pune time) ---------- */
  const markLive = () => {
    const now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Kolkata' }));
    const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
    if (today !== root.dataset.date) return;
    const minutes = now.getHours() * 60 + now.getMinutes();
    $$('.cell[data-start], .timeline li[data-start]').forEach((el) => {
      el.classList.toggle('live', minutes >= +el.dataset.start! && minutes < +el.dataset.end!);
    });
  };
  markLive();
  setInterval(markLive, 60_000);

  renderPlan();

  /* ---------- entrance ---------- */
  if (motion) {
    gsap
      .timeline({ defaults: { ease: 'expo.out' } })
      .from('.title .brace', { x: (i) => (i ? -80 : 80), opacity: 0, duration: 1 })
      .from(
        '.title .word',
        { duration: 1, scrambleText: { text: '', chars: '{}<>/01_', revealDelay: 0.2 } },
        0.1,
      )
      .from('.intro', { y: 20, opacity: 0, duration: 0.8 }, 0.3)
      .from('.stats li', { y: 30, opacity: 0, duration: 0.8, stagger: 0.08 }, 0.4)
      .from(
        '[data-count]',
        { textContent: 0, snap: { textContent: 1 }, duration: 1.6, ease: 'power3.out' },
        0.4,
      )
      .from('.toolbar', { y: 20, opacity: 0, duration: 0.8 }, 0.6);
    revealItems(document.getElementById('view-overview')!);
  }
</script>

<style>
  .agenda {
    padding-block: var(--space-16) var(--space-20);
  }

  /* { Agenda } */
  .title {
    display: flex;
    align-items: center;
    gap: 0.18em;
    margin-bottom: var(--space-6);
    font: 700 var(--text-display) var(--font);
    letter-spacing: -0.03em;
  }
  .brace {
    font-weight: 500;
    color: var(--green);
    transform: translateY(-0.06em);
  }
  .brace:first-child {
    color: var(--blue);
  }
  .intro {
