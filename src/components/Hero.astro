---
import { mainData, isRegistrationOpen } from '../data';
import { googleCalendarUrl, icsFileName } from '../data/calendar';

const { eventInfo } = mainData;
const showRegister = isRegistrationOpen();
// Each theme word ends in a coloured square: Build. Secure. Scale.
const dotColors = ['var(--green)', 'var(--yellow)', 'var(--red)'];
const year = eventInfo.name.match(/\d{4}$/)?.[0] ?? '';
const namePart = eventInfo.name.replace(/\s*\d{4}$/, '');
---

<section class="hero" aria-labelledby="hero-title">
  <canvas class="burst" aria-hidden="true"></canvas>

  <div class="container layout">
    <div class="copy">
      <p class="place">
        <span class="pill">
          <b>पुणे, भारत</b>
          <span aria-hidden="true">|</span>Pune, India
        </span>
        <span class="pill pill--blue">by {mainData.communityName}</span>
      </p>
      <h1 id="hero-title">
        <span class="theme">
          {eventInfo.theme.words.map((word, i) => (
            <span class="word">
              {word}
              <i style={`background: ${dotColors[i % dotColors.length]}`} aria-hidden="true" />
            </span>
          ))}
        </span>
        <span class="name">{namePart}</span>
        <span class="year">{year}</span>
      </h1>
      <div class="bars" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
        <i></i>
      </div>
      <p class="lead">
        <strong>{eventInfo.theme.topics}.</strong> {eventInfo.description.tagline}
      </p>
      <div class="actions">
        {showRegister && (
          <a class="button" href="/register/">
            Register now
          </a>
        )}
        <a
          class:list={['button', showRegister ? 'button--outline' : 'button--secondary']}
          href={eventInfo.callForSpeakers.link}
          rel="noopener"
          target="_blank"
        >
          Submit a talk
        </a>
      </div>
    </div>

    <div class="media">
      <div class="ring">
        <div class="frame">
          <video
            autoplay
            muted
            loop
            playsinline
            preload="none"
            poster="/img/past-devfest/rectangle-1.jpg"
            aria-hidden="true"
            tabindex="-1"
            data-src="/video/hero.webm"
            data-loop-start="7.5"
            data-loop-end="26"
          ></video>
          <p class="badge">
            <span class="dot" aria-hidden="true"></span>
            <span class="countdown" data-start={eventInfo.startDate}>
              {eventInfo.date}
            </span>
          </p>
        </div>
      </div>
    </div>
  </div>

  <dl class="container facts">
    <div>
      <dt>When</dt>
      <dd>
        {eventInfo.date}, {eventInfo.time}
      </dd>
    </div>
    <div>
      <dt>Where</dt>
      <dd>
        <a href={eventInfo.venue.map_link} rel="noopener" target="_blank">
          {eventInfo.venue.name}
        </a>
        , SB Road
      </dd>
    </div>
    <div>
      <dt>Plan ahead</dt>
      <dd>
        <details class="calendar">
          <summary>Add to calendar</summary>
          <div class="menu">
            <a href={googleCalendarUrl} rel="noopener" target="_blank">
              Google Calendar
            </a>
            <a href={`/${icsFileName}`} download={icsFileName}>
              Apple or Outlook (.ics)
            </a>
          </div>
        </details>
      </dd>
    </div>
  </dl>
</section>

<script>
  import { startBurst } from '../scripts/burst';

  const hero = document.querySelector<HTMLElement>('.hero')!;
  const canvas = hero.querySelector<HTMLCanvasElement>('canvas.burst')!;
  const media = hero.querySelector<HTMLElement>('.media')!;

  // The burst streams out from behind the video card.
  startBurst(canvas, () => {
    const h = hero.getBoundingClientRect();
    const m = media.getBoundingClientRect();
    return { x: m.left - h.left + m.width / 2, y: m.top - h.top + m.height / 2 };
  });

  // Load the 9 MB video only on wider screens, without data saver or reduced motion.
  const video = hero.querySelector<HTMLVideoElement>('video')!;
  const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  if (
    video.dataset.src &&
    window.matchMedia('(min-width: 768px)').matches &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
    !connection?.saveData
  ) {
    // The 2025 promo has title cards with last year's date; loop only the event footage.
    const loopStart = Number(video.dataset.loopStart ?? 0);
    const loopEnd = Number(video.dataset.loopEnd ?? Infinity);
    video.src = video.dataset.src;
    video.addEventListener('loadedmetadata', () => (video.currentTime = loopStart), { once: true });
    video.addEventListener('timeupdate', () => {
      if (video.currentTime >= loopEnd) video.currentTime = loopStart;
    });
    video.play().catch(() => {});
  }

  // "53 days to go", refreshed every minute.
  const countdown = hero.querySelector<HTMLElement>('.countdown')!;
  const start = new Date(countdown.dataset.start ?? '').getTime();
  if (!Number.isNaN(start)) {
    const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
    const update = () => {
      const left = start - Date.now();
      if (left <= 0) {
        countdown.textContent = 'Happening now';
        return;
      }
      const days = Math.floor(left / 86_400_000);
      const hours = Math.floor(left / 3_600_000) % 24;
      countdown.textContent =
        days > 0 ? `${plural(days, 'day')} to go` : `${plural(hours, 'hour')} to go`;
    };
    update();
    setInterval(update, 60_000);
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-16) var(--space-12);
  }
  .burst {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .layout,
  .facts {
    position: relative;
  }
  .layout {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .place {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-6);
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--gray);
    font: 500 14px / 20px var(--font);
  }
  .pill b {
    font-weight: 700;
  }
  .pill span {
    color: var(--muted);
  }
  .pill--blue {
    background: #e8f0fe;
    color: #1a56c4;
  }

  /* Headline: theme in black, event name in grey, year in blue */
  h1 {
    margin: 0;
    font: 700 clamp(48px, 6vw, 92px) / 0.95 var(--font);
    letter-spacing: -0.05em;
  }
  .theme,
  .name,
  .year {
    display: block;
  }
  .word {
    display: inline-block;
    margin-right: 0.2em;
  }
  .word i {
    display: inline-block;
    width: 0.13em;
    height: 0.13em;
    margin-left: 0.05em;
  }
  .name {
    margin-top: 0.06em;
    color: var(--grey-1);
  }
  .year {
    color: var(--blue);
  }

  .bars {
    display: flex;
    gap: var(--space-2);
    margin: var(--space-8) 0 var(--space-6);
  }
  .bars i {
    width: 56px;
    height: 5px;
    border-radius: var(--radius-pill);
  }
  .bars i:nth-child(1) {
    background: var(--blue);
  }
  .bars i:nth-child(2) {
    background: var(--green);
  }
  .bars i:nth-child(3) {
    background: var(--yellow);
  }
  .bars i:nth-child(4) {
    background: var(--red);
  }

  .lead {
    max-width: 44ch;
    margin: 0 0 var(--space-8);
    font: 400 var(--text-lg) var(--font);
    color: var(--muted);
  }
  .lead strong {
    color: var(--black);
    font-weight: 600;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .actions .button {
    min-height: 56px;
    padding-inline: var(--space-8);
    font-size: 16px;
  }

  /* Video card with a slowly turning Google-colour ring */
  @property --turn {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }
  .ring {
    padding: 6px;
    border-radius: calc(var(--radius-lg) + 6px);
    background: conic-gradient(
      from var(--turn),
      var(--blue),
      var(--red),
      var(--yellow),
      var(--green),
      var(--blue)
    );
    animation: turn 8s linear infinite;
    box-shadow: 0 30px 80px rgb(66 133 244 / 0.18);
  }
  @keyframes turn {
    to {
      --turn: 360deg;
    }
  }
  .frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--gray);
  }
  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .badge {
    position: absolute;
    left: var(--space-4);
    bottom: var(--space-4);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--white);
    font: 600 var(--text-sm) var(--font);
    box-shadow: 0 6px 20px rgb(30 30 30 / 0.15);
  }
  .badge .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 0 4px rgb(234 67 53 / 0.2);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gutter);
    margin: var(--space-16) auto 0;
  }
  .facts div {
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-md);
    background: rgb(255 255 255 / 0.9);
    border: 1.5px solid var(--border);
    backdrop-filter: blur(4px);
  }
  dt {
    margin-bottom: var(--space-1);
    font: 500 var(--text-sm) var(--font);
    color: var(--muted);
  }
  dd {
    margin: 0;
    font: 600 var(--text-body) var(--font);
  }
  dd a {
    color: inherit;
    text-decoration-color: var(--blue);
    text-underline-offset: 3px;
  }
  .calendar {
    position: relative;
  }
  .calendar summary {
    display: inline;
    color: var(--blue);
    cursor: pointer;
    list-style: none;
  }
  .calendar summary::-webkit-details-marker {
    display: none;
  }
  .calendar summary:hover {
    text-decoration: underline;
  }
  .menu {
    position: absolute;
    z-index: 2;
    top: calc(100% + var(--space-2));
    left: 0;
    display: grid;
    min-width: 220px;
    padding: var(--space-2);
    border: 1.5px solid var(--gray);
    border-radius: var(--radius-md);
    background: var(--white);
    box-shadow: 0 12px 32px rgb(30 30 30 / 0.12);
  }
  .menu a {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--black);
    font: 500 var(--text-sm) var(--font);
    text-decoration: none;
  }
  .menu a:hover {
    background: var(--gray);
  }

  @media (max-width: 1000px) {
    .layout {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }
    .frame {
      aspect-ratio: 16 / 10;
    }
  }
  @media (max-width: 700px) {
    .hero {
      padding-top: var(--space-8);
    }
    .bars i {
      width: 44px;
    }
    .actions .button {
      flex: 1 1 100%;
    }
    .facts {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      margin-top: var(--space-12);
    }
  }
</style>
