---
import { navbarData, mainData, isRegistrationOpen } from '../data';

const current = Astro.url.pathname;
// navbar.json lists Agenda twice (one hidden); de-duplicate by path.
const links = navbarData.filter(
  (item, i, all) => item.visible && all.findIndex((x) => x.path === item.path) === i,
);
const desktopLinks = links.filter((item) => !('mobileMenuOnly' in item && item.mobileMenuOnly));
const showRegister = isRegistrationOpen();
const { eventInfo } = mainData;
const dotColors = ['var(--blue)', 'var(--red)', 'var(--yellow)', 'var(--green)'];
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label={`${eventInfo.name} home`}>
      <img src="/img/devfest-logo.svg" alt="" width="154" height="44" />
    </a>

    <nav class="desktop" aria-label="Main">
      <span class="blob" aria-hidden="true"></span>
      {desktopLinks.map((item) => (
        <a href={item.path} aria-current={current === item.path ? 'page' : undefined}>
          {item.name}
        </a>
      ))}
    </nav>

    <div class="end">
      {showRegister && (
        <a class="button register" href="/register/">
          Register
          <span class="days" data-days={eventInfo.startDate} hidden />
        </a>
      )}
      <button
        class="toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <i></i>
        <i></i>
      </button>
    </div>
  </div>
  <div class="progress" aria-hidden="true">
    <span></span>
  </div>

  <!-- Phone menu: full screen, big links -->
  <div class="sheet" id="mobile-menu" hidden>
    <nav aria-label="Mobile">
      {links.map((item, i) => (
        <a
          href={item.path}
          aria-current={current === item.path ? 'page' : undefined}
          style={`--i: ${i}; --dot: ${dotColors[i % dotColors.length]}`}
        >
          <i aria-hidden="true" />
          {item.name}
        </a>
      ))}
    </nav>
    <div class="sheet-foot" style={`--i: ${links.length}`}>
      <p>
        {eventInfo.date}
        <br />
        {eventInfo.venue.name}
      </p>
      {showRegister && (
        <a class="button" href="/register/">
          Register now
        </a>
      )}
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const nav = header.querySelector<HTMLElement>('nav.desktop')!;
  const blob = nav.querySelector<HTMLElement>('.blob')!;
  const navLinks = [...nav.querySelectorAll<HTMLAnchorElement>('a')];
  const active = navLinks.find((a) => a.getAttribute('aria-current') === 'page');

  /* Sliding highlight: follows hover/focus, returns to the current page. */
  const moveBlob = (to?: HTMLElement) => {
    if (!to) {
      blob.style.opacity = '0';
      return;
    }
    blob.style.opacity = '1';
    blob.style.width = `${to.offsetWidth}px`;
    blob.style.transform = `translateX(${to.offsetLeft}px)`;
  };
  navLinks.forEach((a) => {
    a.addEventListener('pointerenter', () => moveBlob(a));
    a.addEventListener('focus', () => moveBlob(a));
  });
  nav.addEventListener('pointerleave', () => moveBlob(active));
  nav.addEventListener('focusout', () => moveBlob(active));
  // Place it without animating on load and after fonts settle.
  const place = () => {
    blob.style.transition = 'none';
    moveBlob(active);
    blob.offsetWidth;
    blob.style.transition = '';
  };
  place();
  document.fonts.ready.then(place);
  window.addEventListener('resize', place);

  /* Scrolled state and Google-colour progress line */
  const bar = header.querySelector<HTMLElement>('.progress span')!;
  let ticking = false;
  const onScroll = () => {
    ticking = false;
    const max = document.documentElement.scrollHeight - innerHeight;
    header.classList.toggle('scrolled', scrollY > 8);
    bar.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
  };
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) requestAnimationFrame(onScroll);
      ticking = true;
    },
    { passive: true },
  );
  onScroll();

  /* Days left on the Register button */
  const days = header.querySelector<HTMLElement>('[data-days]');
  if (days) {
    const left = Math.ceil((new Date(days.dataset.days!).getTime() - Date.now()) / 86_400_000);
    if (left > 0) {
      days.textContent = `${left}d`;
      days.hidden = false;
    }
  }

  /* Phone menu */
  const toggle = header.querySelector<HTMLButtonElement>('.toggle')!;
  const sheet = header.querySelector<HTMLElement>('.sheet')!;
  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.documentElement.classList.toggle('menu-open', open);
    if (open) {
      sheet.hidden = false;
      requestAnimationFrame(() => sheet.classList.add('open'));
    } else {
      sheet.classList.remove('open');
      setTimeout(() => !sheet.classList.contains('open') && (sheet.hidden = true), 300);
    }
  };
  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  sheet.addEventListener('click', (e) => (e.target as HTMLElement).closest('a') && setOpen(false));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  matchMedia('(min-width: 901px)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    transition: box-shadow 250ms ease;
  }
  /* The blur lives on a background layer: backdrop-filter on the header itself would trap the
     fixed-position phone menu inside the header's box. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(255 255 255 / 0.85);
    backdrop-filter: blur(12px) saturate(1.4);
  }
  .site-header.scrolled {
    box-shadow: 0 6px 24px rgb(30 30 30 / 0.06);
  }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-4);
    min-height: 64px;
  }
  .brand {
    display: flex;
    justify-self: start;
    transition: transform 300ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .brand:hover {
    transform: rotate(-3deg) scale(1.04);
  }
  .brand img {
    height: 40px;
    width: auto;
  }

  /* Desktop: links in a pill with a gliding white highlight */
  .desktop {
    position: relative;
    display: flex;
    padding: 4px;
    border-radius: var(--radius-pill);
    background: var(--gray);
  }
  .blob {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 0;
    border-radius: var(--radius-pill);
    background: var(--white);
    box-shadow: 0 2px 8px rgb(30 30 30 / 0.1);
    transition:
      transform 400ms cubic-bezier(0.3, 1.3, 0.5, 1),
      width 400ms cubic-bezier(0.3, 1.3, 0.5, 1),
      opacity 200ms ease;
  }
  .desktop a {
    position: relative;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    color: var(--muted);
    font: 500 15px / 20px var(--font);
    text-decoration: none;
    transition: color 200ms ease;
  }
  .desktop a:hover,
  .desktop a:focus-visible,
  .desktop a[aria-current='page'] {
    color: var(--black);
  }
  .desktop a[aria-current='page'] {
    font-weight: 600;
  }

  .end {
    display: flex;
    justify-self: end;
    align-items: center;
    gap: var(--space-2);
  }
  .register {
    min-height: 44px;
    padding: 0 var(--space-4) 0 var(--space-6);
  }
  .days {
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    background: var(--black);
    color: var(--yellow-halftone);
    font:
      600 12px / 16px var(--font-code),
      monospace;
  }

  /* Scroll progress in Google colours */
  .progress {
    height: 3px;
    background: var(--border);
  }
  .progress span {
    display: block;
    height: 100%;
    background: linear-gradient(
      90deg,
      var(--blue) 0 25%,
      var(--red) 25% 50%,
      var(--yellow) 50% 75%,
      var(--green) 75%
    );
    transform: scaleX(0);
    transform-origin: left;
  }

  /* Hamburger that turns into a cross */
  .toggle {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: var(--gray);
    cursor: pointer;
  }
  .toggle i {
    position: absolute;
    left: 13px;
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: var(--black);
    transition: transform 300ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .toggle i:first-child {
    transform: translateY(-4px);
  }
  .toggle i:last-child {
    transform: translateY(4px);
  }
  .toggle[aria-expanded='true'] i:first-child {
    transform: rotate(45deg);
  }
  .toggle[aria-expanded='true'] i:last-child {
    transform: rotate(-45deg);
  }

  /* Phone menu sheet */
  .sheet {
    position: fixed;
    inset: 67px 0 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-6) var(--gutter) var(--space-8);
    background: var(--white);
    overflow-y: auto;
    opacity: 0;
    transition: opacity 250ms ease;
  }
  /* display: flex above would otherwise override [hidden] and leave an invisible layer over the page. */
  .sheet[hidden] {
    display: none;
  }
  .sheet.open {
    opacity: 1;
  }
  .sheet nav {
    display: grid;
  }
  .sheet a:not(.button),
  .sheet-foot {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 400ms ease calc(var(--i) * 40ms),
      transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--i) * 40ms);
  }
  .sheet.open a:not(.button),
  .sheet.open .sheet-foot {
    opacity: 1;
    transform: none;
  }
  .sheet nav a {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border);
    color: var(--black);
    font: 700 32px / 1.2 var(--font);
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .sheet nav a i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--dot);
    transform: scale(0.6);
    transition: transform 200ms ease;
  }
  .sheet nav a[aria-current='page'] i,
  .sheet nav a:active i {
    transform: scale(1.2);
  }
  .sheet nav a[aria-current='page'] {
    color: var(--blue);
  }
  .sheet-foot {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-4);
    padding-top: var(--space-8);
  }
  .sheet-foot p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }
  :global(html.menu-open) {
    overflow: hidden;
  }

  @media (max-width: 1100px) {
    .desktop a {
      padding: 8px 11px;
    }
  }
  @media (max-width: 900px) {
    .bar {
      grid-template-columns: 1fr auto;
    }
    .desktop {
      display: none;
    }
    .toggle {
      display: block;
    }
    .brand img {
      height: 36px;
    }
  }
  @media (max-width: 420px) {
    .register .days {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .blob,
    .sheet,
    .sheet a,
    .sheet-foot,
    .toggle i {
      transition: none;
    }
  }
</style>
