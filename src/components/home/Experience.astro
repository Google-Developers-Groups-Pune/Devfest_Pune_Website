---
import { mainData } from '../../data';

const { whatToExpect, description } = mainData.eventInfo;
// One particle icon per panel, in the style guide's particle colours.
const looks = [
  { icon: 'code', color: '#4285f4', bg: 'var(--blue-pastel)' },
  { icon: 'talk', color: '#ea4335', bg: 'var(--red-pastel)' },
  { icon: 'network', color: '#34a853', bg: 'var(--green-pastel)' },
];
---

<!-- Pinned horizontal scroll on wide screens; a plain vertical stack otherwise. -->
<section class="experience" aria-labelledby="experience-heading">
  <div class="track">
    <div class="panel intro">
      <h2 id="experience-heading" data-scramble>
        What the day looks like
      </h2>
      <p class="text-lg">{description.additionalText}</p>
    </div>
    {whatToExpect.map((item, i) => {
      const look = looks[i % looks.length];
      return (
        <article class="panel card-panel" style={`--panel-bg: ${look.bg}`}>
          <canvas data-icon={look.icon} data-color={look.color} aria-hidden="true" />
          <div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        </article>
      );
    })}
  </div>
  <div class="progress" aria-hidden="true">
    <i></i>
  </div>
</section>

<style>
  .experience {
    position: relative;
    overflow: hidden;
  }
  .track {
    display: flex;
    gap: var(--gutter);
    width: max-content;
    height: 100svh;
    padding: var(--space-24) var(--gutter) var(--space-16);
    padding-left: max(var(--gutter), calc((100vw - var(--max-width)) / 2));
  }
  .panel {
    flex: none;
    width: min(64vw, 820px);
    height: 100%;
    border-radius: var(--radius-lg);
  }
  .intro {
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: min(46vw, 560px);
  }
  .intro h2 {
    font: 700 var(--text-display) var(--font);
    letter-spacing: -0.03em;
  }
  .intro p {
    color: var(--muted);
  }
  .card-panel {
    display: grid;
    grid-template-rows: 1fr auto;
    padding: var(--space-12);
    background: var(--panel-bg);
    cursor: crosshair;
  }
  canvas {
    width: 100%;
    height: 100%;
    min-height: 0;
  }
  h3 {
    font: 700 var(--text-h2) var(--font);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }
  .card-panel p {
    max-width: 52ch;
    margin: 0;
    font: var(--text-lg) var(--font);
  }
  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 6px;
    background: var(--gray);
  }
  .progress i {
    display: block;
    height: 100%;
    background: linear-gradient(
      90deg,
      var(--blue) 0 25%,
      var(--red) 25% 50%,
      var(--yellow) 50% 75%,
      var(--green) 75%
    );
    transform: scaleX(0);
    transform-origin: left;
  }

  @media (max-width: 899px) {
    .track {
      flex-direction: column;
      width: auto;
      height: auto;
      padding: var(--space-12) var(--gutter);
    }
    .panel,
    .intro {
      width: 100%;
      height: auto;
    }
    .intro h2 {
      font: 700 var(--text-h2) var(--font);
    }
    .card-panel {
      padding: var(--space-6);
      grid-template-rows: 240px auto;
    }
    .progress {
      display: none;
    }
  }
</style>
