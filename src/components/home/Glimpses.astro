---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { mainData } from '../../data';

// Photos live in src/assets/glimpses so Astro can resize them and serve modern formats.
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/glimpses/*', {
  eager: true,
});
const all = mainData.eventInfo.pastDevFest.gallery
  .map((p) => ({ ...p, image: files[`../../assets/glimpses/${p.file}`]?.default }))
  .filter((p) => p.image)
  .slice(0, 4);
// The featured print goes last, so it's dealt last and lands on top of the others.
const prints = [
  ...all.filter((p) => !('featured' in p && p.featured)),
  ...all.filter((p) => 'featured' in p && p.featured),
];
const isFeatured = (p: (typeof prints)[number]) => 'featured' in p && !!p.featured;
---

<!-- Polaroids on a table: they're dealt from a pile, develop like instant film, and can be tossed around. -->
<section class="glimpses section container" aria-labelledby="glimpses-heading">
  <div class="intro">
    <div>
      <h2 id="glimpses-heading" data-scramble>
        Glimpses from DevFest Pune
      </h2>
      <p class="text-lg">
        A few prints from past editions. Pick one up and toss it around the table.
      </p>
    </div>
    <button class="button button--outline" data-deal>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 7h11l-3-3M20 17H9l3 3M4 7l3 3M20 17l-3-3"></path>
      </svg>
      Deal again
    </button>
  </div>

  <div class="table">
    {prints.map((print, i) => (
      <figure
        class:list={['print', isFeatured(print) ? 'featured' : `spot-${i + 1}`]}
        data-print={i}
      >
        <div class="photo">
          <Image
            src={print.image}
            alt={print.caption}
            widths={isFeatured(print) ? [700, 1200] : [400, 700]}
            sizes={
              isFeatured(print)
                ? '(max-width: 700px) 90vw, 640px'
                : '(max-width: 700px) 46vw, 300px'
            }
            loading="lazy"
          />
          <span class="film" aria-hidden="true" />
        </div>
        <figcaption>{print.caption}</figcaption>
      </figure>
    ))}
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { Draggable } from 'gsap/Draggable';
  import { InertiaPlugin } from 'gsap/InertiaPlugin';

  gsap.registerPlugin(ScrollTrigger, Draggable, InertiaPlugin);

  const section = document.querySelector<HTMLElement>('.glimpses')!;
  const table = section.querySelector<HTMLElement>('.table')!;
  const prints = [...section.querySelectorAll<HTMLElement>('.print')];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let top = prints.length;

  const bringToFront = (print: HTMLElement) => (print.style.zIndex = String(++top));

  // Offset that moves a print from its spot to the middle of the table (the pile).
  const toPile = (print: HTMLElement) => {
    const t = table.getBoundingClientRect();
    const p = print.getBoundingClientRect();
    const current = {
      x: Number(gsap.getProperty(print, 'x')),
      y: Number(gsap.getProperty(print, 'y')),
    };
    return {
      x: t.left + t.width / 2 - (p.left - current.x + p.width / 2),
      y: t.top + t.height / 2 - (p.top - current.y + p.height / 2),
    };
  };

  function deal({ develop }: { develop: boolean }) {
    const tl = gsap.timeline();
    // Gather into a neat pile in the middle, then deal each print to its spot.
    prints.forEach((print, i) => {
      const pile = toPile(print);
      tl.set(print, { x: pile.x, y: pile.y, rotation: (i - 1.5) * 3, zIndex: i + 1 }, 0);
    });
    prints.forEach((print, i) => {
      const at = 0.15 + i * 0.28;
      tl.to(
        print,
        { x: 0, y: 0, rotation: Number(print.dataset.rot), duration: 0.9, ease: 'expo.out' },
        at,
      );
      if (develop) {
        const film = print.querySelector('.film');
        const img = print.querySelector('img');
        // Camera flash as it lands, then the photo develops from a milky blank.
        tl.fromTo(
          film,
          { opacity: 1, backgroundColor: '#ffffff' },
          { opacity: 0.85, backgroundColor: '#f3efe2', duration: 0.25 },
          at + 0.35,
        )
          .to(film, { opacity: 0, duration: 2.6, ease: 'power1.inOut' }, at + 0.6)
          .fromTo(
            img,
            { filter: 'saturate(0) brightness(1.5) blur(3px)' },
            { filter: 'saturate(1) brightness(1) blur(0px)', duration: 2.8, ease: 'power1.inOut' },
            at + 0.6,
          );
      }
    });
    top = prints.length;
    return tl;
  }

  // Each print's resting tilt, read from CSS so it can differ per breakpoint.
  prints.forEach((print) => {
    print.dataset.rot =
      getComputedStyle(print).getPropertyValue('--rot').replace('deg', '').trim() || '0';
    gsap.set(print, { rotation: Number(print.dataset.rot) });
    print.addEventListener('pointerdown', () => bringToFront(print));
  });

  if (reduce) {
    section.classList.add('developed');
  } else {
    // Start undeveloped and piled up; deal when the table scrolls into view.
    gsap.set(section.querySelectorAll('.film'), { opacity: 1 });
    gsap.set(section.querySelectorAll('.print img'), {
      filter: 'saturate(0) brightness(1.5) blur(3px)',
    });
    prints.forEach((print, i) => {
      const pile = toPile(print);
      gsap.set(print, { x: pile.x, y: pile.y, rotation: (i - 1.5) * 3, zIndex: i + 1 });
    });
    ScrollTrigger.create({
      trigger: table,
      start: 'top 70%',
      once: true,
      onEnter: () => deal({ develop: true }),
    });
  }

  section.querySelector('[data-deal]')!.addEventListener('click', () => {
    if (reduce) return;
    deal({ develop: false });
  });

  // Pick up and toss on devices with a mouse or trackpad; touch keeps normal scrolling.
  gsap.matchMedia().add('(hover: hover) and (pointer: fine)', () => {
    const draggables = Draggable.create(prints, {
      type: 'x,y',
      bounds: table,
      edgeResistance: 0.6,
      inertia: !reduce,
      zIndexBoost: false,
      onPress() {
        bringToFront(this.target);
        gsap.to(this.target, { scale: 1.05, duration: 0.2, overwrite: 'auto' });
        this.target.classList.add('lifted');
      },
      onDrag() {
        // Lean in the direction of travel, like a card being slid across a table.
        gsap.to(this.target, {
          rotation: Number(this.target.dataset.rot) + gsap.utils.clamp(-12, 12, this.deltaX * 0.6),
          duration: 0.3,
        });
      },
      onRelease() {
        gsap.to(this.target, { scale: 1, duration: 0.4, ease: 'back.out(2)' });
        this.target.classList.remove('lifted');
      },
      onThrowComplete() {
        gsap.to(this.target, {
          rotation: Number(this.target.dataset.rot),
          duration: 0.6,
          ease: 'back.out(2)',
        });
      },
    });
    return () => draggables.forEach((d) => d.kill());
  });
</script>

<style>
  .intro {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-4) var(--space-8);
    margin-bottom: var(--space-8);
  }
  .intro h2 {
    margin-bottom: var(--space-2);
  }
  .intro p {
    max-width: 52ch;
    margin: 0;
    color: var(--muted);
  }
  .intro svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The table: a soft dotted surface for the prints */
  .table {
    position: relative;
    height: clamp(560px, 52vw, 720px);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle, rgb(30 30 30 / 0.08) 1.2px, transparent 1.4px) 0 0 / 22px 22px,
      var(--yellow-pastel);
  }

  /* Polaroid prints, each with its own spot and tilt */
  .print {
    --w: 25%;
    position: absolute;
    width: var(--w);
    margin: 0;
    padding: 14px 14px 0;
    background: var(--white);
    border-radius: 6px;
    box-shadow:
      0 2px 4px rgb(30 30 30 / 0.12),
      0 18px 40px rgb(30 30 30 / 0.18);
    cursor: grab;
    user-select: none;
    touch-action: auto;
    transition: box-shadow 250ms ease;
  }
  .print:global(.lifted) {
    cursor: grabbing;
    box-shadow:
      0 4px 8px rgb(30 30 30 / 0.12),
      0 40px 70px rgb(30 30 30 / 0.3);
  }
  /* The featured print sits big in the middle; the others peek out around it. */
  .featured {
    --w: 54%;
    --rot: -2deg;
    left: 23%;
    top: 7%;
    padding: 18px 18px 0;
  }
  .featured figcaption {
    font-size: 36px;
    padding: 14px 4px 18px;
  }
  .spot-1 {
    --w: 25%;
    --rot: -8deg;
    left: 3%;
    top: 12%;
  }
  .spot-2 {
    --w: 25%;
    --rot: 7deg;
    left: 72%;
    top: 6%;
  }
  .spot-3 {
    --w: 25%;
    --rot: -5deg;
    left: 70%;
    top: 54%;
  }
  .photo {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: #f3efe2;
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  /* Milky layer that fades as the "instant film" develops */
  .film {
    position: absolute;
    inset: 0;
    background: #f3efe2;
    opacity: 0;
    pointer-events: none;
  }
  .developed .film {
    opacity: 0;
  }
  figcaption {
    padding: 10px 4px 14px;
    font:
      600 26px / 1.1 var(--font-hand),
      cursive;
    color: var(--black);
    text-align: center;
  }

  @media (max-width: 700px) {
    .table {
      height: 620px;
    }
    .print {
      padding: 8px 8px 0;
    }
    figcaption {
      font-size: 21px;
      padding-bottom: 10px;
    }
    .featured {
      --w: 90%;
      left: 5%;
      top: 2%;
      padding: 12px 12px 0;
    }
    .featured figcaption {
      font-size: 26px;
    }
    .spot-1 {
      --w: 48%;
      left: 1%;
      top: 50%;
    }
    .spot-2 {
      --w: 48%;
      left: 50%;
      top: 54%;
    }
    .spot-3 {
      --w: 48%;
      left: 26%;
      top: 72%;
    }
  }
</style>
