---
import { mainData, isRegistrationOpen } from '../../data';
import { googleCalendarUrl } from '../../data/calendar';

const { eventInfo } = mainData;
const date = new Date(eventInfo.startDate);
const format = (month: 'long' | 'short') =>
  date.toLocaleDateString('en-GB', { day: 'numeric', month, timeZone: 'Asia/Kolkata' });
const day = format('long');
const showRegister = isRegistrationOpen();
---

<section class="cta section" aria-labelledby="cta-heading">
  <h2 id="cta-heading" class="sr-only">
    See you on {day}
  </h2>
  <canvas data-text={`See you on|${format('short')}`} aria-hidden="true"></canvas>
  <div class="container below">
    <p class="text-lg">
      {eventInfo.time} at {eventInfo.venue.name}
    </p>
    <div class="actions">
      {showRegister ? (
        <a class="button" href="/register/">
          Register now
        </a>
      ) : (
        <a
          class="button button--secondary"
          href={eventInfo.callForSpeakers.link}
          rel="noopener"
          target="_blank"
        >
          Submit a talk
        </a>
      )}
      <a class="button button--outline" href={googleCalendarUrl} rel="noopener" target="_blank">
        Add to calendar
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    text-align: center;
  }
  canvas {
    display: block;
    width: 100%;
    height: clamp(300px, 42vw, 560px);
    cursor: crosshair;
  }
  .below p {
    margin: 0 0 var(--space-6);
    color: var(--muted);
  }
  @media (max-width: 600px) {
    canvas {
      height: 92vw;
    }
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }
</style>
